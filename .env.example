# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Production values go in Vercel -> Settings -> Environment Variables (see docs/GO-LIVE.md).

# --- Database (required) ---
# Local: run `npm run db:local` in its own terminal, then use this address.
# Production: the MongoDB Atlas connection string (mongodb+srv://...).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Database name. Defaults to "shop".
MONGODB_DB=shop

# --- Sign-in (required) ---
# A long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The shop's public address. Used in emails and Stripe return links.
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Payments: Stripe (optional locally) ---
# sk_test_... for trials, sk_live_... for real payments.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Email: Resend (optional locally; without it, emails are not sent) ---
RESEND_API_KEY=
# Sender, e.g. Your Shop <orders@yourshop.co.uk>. Defaults to "Shop <no-reply@localhost>".
EMAIL_FROM=
# Fallback address for shop notifications when none is set in Admin -> Settings -> Notifications.
SHOP_NOTIFY_EMAIL=

# --- Image uploads in the admin panel: Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Demo access gate (optional) ---
# When SITE_PASSWORD is set, every page asks for username "demo" and this password, and is hidden from search engines.
# Visitors can skip the prompt with the link /?access=SITE_ACCESS_KEY (remembered for 30 days).
# Leave both empty to turn the gate off.
SITE_PASSWORD=
SITE_ACCESS_KEY=
