# The reference catalogue from the original site (data/cctvmaster/, public/sites/cctvmaster/) and its research
# screenshots (docs/research/cctvmaster/) are kept in this private repository for local development only.
# .vercelignore keeps them out of every deployment: they are never part of the live shop.

# Database snapshot loaded by scripts/import-snapshot.ts: contains accounts, never committed
snapshot/
# Full database copy used by `npm run db:restore`: contains accounts and customer orders, never committed
database/
.env*
# The template below has no secrets and is committed so new setups know what to fill in
!.env.example
