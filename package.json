{
  "name": "electronics-shop",
  "version": "1.0.0",
  "private": true,
  "description": "CCTV Spania online shop: Next.js storefront and admin panel on MongoDB",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "tsx scripts/import-snapshot.ts && tsx scripts/use-brand-logo.ts && tsx scripts/rebrand.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:local": "node scripts/mongo-local.mjs",
    "admin:create": "tsx scripts/create-owner.ts",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:restore": "tsx --env-file-if-exists=.env.local scripts/restore-database.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.6.0",
    "mongodb": "^7.7.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.18",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "shadcn": "^4.1.0",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mongodb-memory-server": "^11.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
